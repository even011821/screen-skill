{
  "id": "widget-kpi-card-style15",
  "label": "KPI Card Style15",
  "category": "widget",
  "kind": "kpi-card",
  "style": "Style15",
  "assetType": "code",
  "size": {
    "w": 179,
    "h": 96
  },
  "minSize": {
    "w": 160,
    "h": 80
