      "default": "工单总量",
      "required": false
    }
  ],
  "dataShape": {
    "value": "string|number",
    "unit": "string",
    "label": "string"
  },
  "adaptation": {
    "renderingMode": "css-png-svg-hybrid",
    "usesFullNodeScreenshot": false,
    "usesLocalAssets": true,
    "supportsWidthStretch": true,
    "supportsHeightStretch": true
  },
  "status": "ready"
