  "assets": [
    {
      "name": "header-bg",
      "file": "assets/header-bg.svg",
      "usage": "header background path"
    },
    {
      "name": "internal-left",
      "file": "assets/internal-left.svg",
      "usage": "left header decoration"
    },
    {
      "name": "internal-right",
      "file": "assets/internal-right.svg",
      "usage": "right header decoration"
    },
    {
      "name": "bottom-line",
