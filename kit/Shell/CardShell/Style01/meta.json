      "usage": "left header accent"
    }
  ],
  "cssVariables": {
    "--style01-accent": "#1AA8FD",
    "--style01-title": "#EAFEFF",
    "--style01-body-bg": "rgba(14, 22, 31, 0.94)",
    "--style01-border": "rgba(26, 168, 253, 0.78)"
