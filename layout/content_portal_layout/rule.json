{
  "id": "content_portal_layout",
  "label": "内容展陈门户型",
  "version": "1.0.0",
  "mainVisualType": [
    "content",
    "media",
    "portal",
    "exhibition",
    "story"
  ],
  "selection": {
    "useWhen": [
      "资讯",
      "视频",
      "文章",
      "党建",
      "文旅",
      "展厅",
      "宣传",
      "品牌",
      "专题",
      "活动"
    ],
    "avoidWhen": [
      "核心是实时设备告警",
      "核心是地图点位态势",
      "核心是订单流程"
    ],
    "fallbackWhen": "用户的数据不是唯一重点，图文、视频、资讯或专题内容占比较高。"
  },
  "canvas": {
    "baseline": {
      "w": 1920,
      "h": 1080
    },
    "contentArea": "computed-after-topnav",
    "gap": 16
  },
  "slotStrategy": {
    "PrimarySlot": {
      "required": true,
      "role": "最高优先级区域，通常放主内容、主视觉或主指标；具体内容由需求和指标分析决定",
      "shell": "PanelShell",
      "widthRatio": [
        0.38,
        0.62
      ],
      "heightRatio": [
        0.44,
        0.74
      ],
      "minSize": {
        "w": 680,
        "h": 420
      },
      "placement": "center-or-feature"
    },
    "ContextSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常靠左或靠近主区域分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "side"
    },
    "StatusSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常靠右或靠近主区域分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "side"
    },
    "DetailSlot": {
      "required": false,
      "role": "补充信息候选区域，通常在底部、页签或扩展区承载低优先级内容；不固定内容类型",
      "shell": "CardShell",
      "placement": "bottom-or-side"
    },
    "OverlaySlot": {
      "required": false,
      "role": "附着在主区域上的局部说明层，仅在主内容需要标注时使用",
      "shell": "none",
      "placement": "inside-primary"
    }
  },
  "densityBehavior": {
    "low": "强化视觉叙事，数据只做辅助说明。",
    "medium": "主内容和统计并重，资讯/图文按主题分组。",
    "high": "内容使用分类、轮播和页签，避免变成纯数据网格。",
    "extreme": "首屏只放核心专题和关键入口，其余下钻。"
  },
  "componentPreference": {
    "PrimarySlot": [
      "PanelShell",
      "media container",
      "echarts:map when content has region and local geoJSON/SVG exists"
    ],
    "ContextSlot": [
      "widget:kpi-card",
      "dom:big-number",
      "echarts:pie"
    ],
    "StatusSlot": [
      "dom:ranking-list",
      "dom:alert-list"
    ],
    "DetailSlot": [
      "dom:ranking-list",
      "dom:card-list",
      "dom:timeline"
    ]
  },
  "hardRules": [
    "内容展示和数据统计并重，不能做成纯监控卡片堆叠。",
    "主内容区优先 PanelShell 或无标题背景。",
    "资讯、列表、统计模块默认 CardShell。"
  ],
  "variantCatalog": "variants/catalog.json",
  "variantSelection": {
    "required": true,
    "rule": "Read variants/catalog.json after this rule.json. Select layoutVariant before calculating panel geometry.",
    "recordInChangeLog": [
      "layoutVariant id",
      "selection reason",
      "primaryArea or structure",
      "slot business topics"
    ],
    "doNotUseFixedTemplate": true
  }
}
