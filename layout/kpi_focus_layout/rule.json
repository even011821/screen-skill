{
  "id": "kpi_focus_layout",
  "label": "中心核心指标型",
  "version": "1.0.0",
  "mainVisualType": [
    "core_kpi",
    "target_progress",
    "big_number",
    "goal"
  ],
  "selection": {
    "useWhen": [
      "总额",
      "总数",
      "完成率",
      "目标",
      "达成",
      "业绩",
      "销售额",
      "产值",
      "核心指标"
    ],
    "avoidWhen": [
      "核心对象是地图",
      "核心对象是3D场景",
      "核心任务是订单流程表格"
    ],
    "fallbackWhen": "用户关注一个最重要的数字、目标或完成进度。"
  },
  "canvas": {
    "baseline": {
      "w": 1920,
      "h": 1080
    },
    "contentArea": "computed-after-topnav",
    "gap": 16
  },
  "slotStrategy": {
    "PrimarySlot": {
      "required": true,
      "role": "最高优先级区域，通常放主指标或核心目标；具体内容由指标分析决定",
      "shell": "CardShell",
      "widthRatio": [
        0.34,
        0.52
      ],
      "heightRatio": [
        0.32,
        0.56
      ],
      "minSize": {
        "w": 560,
        "h": 300
      },
      "placement": "center-focus"
    },
    "ContextSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常围绕主指标分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "around-primary"
    },
    "StatusSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常靠右或靠近主区域分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "right-or-near-primary"
    },
    "DetailSlot": {
      "required": false,
      "role": "补充信息候选区域，通常在底部、页签或扩展区承载低优先级内容；不固定内容类型",
      "shell": "CardShell",
      "placement": "bottom"
    },
    "OverlaySlot": {
      "required": false,
      "role": "附着在主区域上的局部说明层，仅在主指标需要标注时使用",
      "shell": "none",
      "placement": "inside-primary"
    }
  },
  "densityBehavior": {
    "low": "强化中心大数字，保留少量来源和状态解释。",
    "medium": "围绕核心KPI拆成来源、趋势、排行、目标进度。",
    "high": "把指标合并为经营目标、来源拆解、趋势、异常、明细。",
    "extreme": "首屏保留核心KPI和关键差异；更多明细进入页签或下钻。"
  },
  "componentPreference": {
    "PrimarySlot": [
      "dom:big-number",
      "widget:kpi-card",
      "echarts:gauge"
    ],
    "ContextSlot": [
      "echarts:line",
      "echarts:bar",
      "echarts:pie",
      "dom:ranking-list"
    ],
    "StatusSlot": [
      "widget:kpi-card",
      "dom:alert-list"
    ],
    "DetailSlot": [
      "dom:ranking-list",
      "echarts:line",
      "dom:table"
    ]
  },
  "hardRules": [
    "中心必须有明确核心指标，不能把所有KPI平均铺开。",
    "无地图或场景需求时，不强行加入地图/3D。",
    "核心指标模块通常使用 CardShell；无标题大背景才使用 PanelShell。"
  ],
  "variantCatalog": "variants/catalog.json",
  "variantSelection": {
    "required": true,
    "rule": "Read variants/catalog.json after this rule.json. Select layoutVariant before calculating panel geometry.",
    "recordInChangeLog": [
      "layoutVariant id",
      "selection reason",
      "primaryArea or structure",
      "slot business topics"
    ],
    "doNotUseFixedTemplate": true
  }
}
