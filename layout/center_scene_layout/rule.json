{
  "id": "center_scene_layout",
  "label": "单主视觉环绕型",
  "version": "1.0.0",
  "mainVisualType": [
    "scene",
    "3d",
    "digital_twin",
    "building",
    "factory",
    "park",
    "campus",
    "port"
  ],
  "selection": {
    "useWhen": [
      "园区",
      "工厂",
      "楼宇",
      "建筑",
      "3D",
      "数字孪生",
      "场景",
      "车间",
      "基地",
      "港口"
    ],
    "avoidWhen": [
      "只有表格流程",
      "只有资讯门户",
      "核心对象是地图且有明确区域点位"
    ],
    "fallbackWhen": "存在明确主视觉对象，但没有地图点位态势或流程表格作为核心。"
  },
  "canvas": {
    "baseline": {
      "w": 1920,
      "h": 1080
    },
    "contentArea": "computed-after-topnav",
    "gap": 16
  },
  "slotStrategy": {
    "PrimarySlot": {
      "required": true,
      "role": "最高优先级区域，通常放中心主视觉或主指标；具体内容由指标分析决定",
      "shell": "PanelShell",
      "widthRatio": [
        0.42,
        0.62
      ],
      "heightRatio": [
        0.62,
        0.86
      ],
      "minSize": {
        "w": 720,
        "h": 520
      },
      "placement": "center-dominant"
    },
    "ContextSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常靠左或靠近主区域分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "left-or-near-primary"
    },
    "StatusSlot": {
      "required": false,
      "role": "中高优先级辅助区域，通常靠右或靠近主区域分布；不固定内容类型",
      "shell": "CardShell",
      "placement": "right-or-near-primary"
    },
    "DetailSlot": {
      "required": false,
      "role": "补充信息候选区域，通常在底部、页签或扩展区承载低优先级内容；不固定内容类型",
      "shell": "CardShell",
      "placement": "bottom-when-density-medium-or-high"
    },
    "OverlaySlot": {
      "required": false,
      "role": "附着在主区域上的局部标注层，仅在主视觉需要说明时使用",
      "shell": "none",
      "placement": "inside-primary"
    }
  },
  "densityBehavior": {
    "low": "扩大 PrimarySlot，只保留核心指标和关键状态。",
    "medium": "保持 PrimarySlot 第一焦点，周边按业务主题分组。",
    "high": "合并为运行概况、设备状态、告警事件、趋势分析等主题组。",
    "extreme": "首屏只保留高优先级；中低优先级进入页签、轮播、弹窗或下钻。"
  },
  "componentPreference": {
    "PrimarySlot": [
      "PanelShell",
      "echarts:map if scene is unavailable and local geoJSON/SVG exists",
      "custom 3D/canvas container"
    ],
    "ContextSlot": [
      "widget:kpi-card",
      "echarts:line",
      "echarts:bar",
      "echarts:pie",
      "dom:ranking-list"
    ],
    "StatusSlot": [
      "dom:alert-list",
      "dom:ranking-list",
      "widget:kpi-card"
    ],
    "DetailSlot": [
      "echarts:line",
      "dom:ranking-list",
      "dom:table"
    ]
  },
  "hardRules": [
    "不固定左侧或右侧卡片数量。",
    "周边模块不能抢占中心主视觉。",
    "没有场景/3D/园区/工厂对象时，不强行使用该布局。",
    "PrimarySlot 主视觉背景优先使用 PanelShell；业务卡片默认 CardShell。"
  ],
  "variantCatalog": "variants/catalog.json",
  "variantSelection": {
    "required": true,
    "rule": "Read variants/catalog.json after this rule.json. Select layoutVariant before calculating panel geometry.",
    "recordInChangeLog": [
      "layoutVariant id",
      "selection reason",
      "primaryArea or structure",
      "slot business topics"
    ],
    "doNotUseFixedTemplate": true
  }
}
