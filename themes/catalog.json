  "scenarioThemeRules": [
    {
      "id": "medical-healthcare",
      "match": {
        "industries": [
          "医疗",
          "医院",
          "健康",
          "卫健",
          "公卫",
          "体检",
          "医药",
          "护理",
          "康养"
        ],
        "scenarios": [
          "医疗业务",
          "医院运营",
          "门急诊",
          "住院",
          "体检中心",
          "区域医疗",
          "智慧医疗",
          "医疗收入",
          "病床",
          "医生",
          "患者"
        ]
      },
      "preferredThemes": [
        "fresh-verdant",
        "frost-cyan"
      ],
      "defaultTheme": "fresh-verdant",
      "reason": "医疗健康类场景优先使用清爽、洁净、低压迫感的绿色或青色主题。"
    },
    {
      "id": "industry-manufacturing",
      "match": {
        "industries": [
          "制造业",
          "工厂",
          "工业",
          "五金",
          "装备",
          "设备",
          "生产执行系统",
          "仓储管理系统",
          "仓储",
          "物流"
        ],
        "scenarios": [
          "生产监控",
          "设备运维",
          "质量追溯",
          "仓储物流",
          "工厂驾驶舱",
          "产线",
          "工单",
          "库存",
          "齐套"
        ]
      },
      "preferredThemes": [
        "deep-tech-blue",
        "galaxy-azure",
        "frost-cyan"
      ],
      "defaultTheme": "deep-tech-blue",
      "reason": "工业制造场景优先使用深蓝、蓝青、冷色科技主题，突出稳定、设备和监控属性。"
    },
    {
      "id": "government-command",
      "match": {
        "industries": [
          "政务",
          "城市",
          "交通",
          "公安",
          "园区",
          "城投",
          "住建",
          "水务"
        ],
        "scenarios": [
          "指挥中心",
          "城市运行",
          "城市运行中心",
          "态势感知",
          "交通指挥",
          "综合治理",
          "运营中心"
        ]
      },
      "preferredThemes": [
        "galaxy-azure",
        "deep-tech-blue"
      ],
      "defaultTheme": "galaxy-azure",
      "reason": "政务指挥类场景优先使用稳重、可信赖的蓝色或蓝青科技主题。"
    },
    {
      "id": "finance-investment",
      "match": {
        "industries": [
          "金融",
          "投资",
          "资产",
          "经营",
          "集团",
          "财务",
          "产业投资"
        ],
        "scenarios": [
          "经营分析",
          "资产监管",
          "投资收益",
          "财务驾驶舱",
          "利润",
          "营收",
          "回款",
          "成本"
        ]
      },
      "preferredThemes": [
        "dusk-rose-gold",
        "galaxy-azure"
      ],
      "defaultTheme": "dusk-rose-gold",
      "reason": "金融经营类场景可使用金色、蓝金或稳重商务主题，强化价值和经营感。"
    },
    {
      "id": "emergency-warning",
      "match": {
        "industries": [
          "党政",
          "党建",
          "党员",
          "党委"
        ],
        "scenarios": [
          "党政中心",
          "党建管理",
          "党员发展",
          "党委管理"
        ]
      },
      "preferredThemes": [
        "ember-orange",
        "deep-tech-blue"
      ],
      "defaultTheme": "ember-orange",
      "reason": "只有在党政党建这种场景，才使用这个主题，其他场景不推荐使用。"
    },
    {
      "id": "education-campus",
      "match": {
        "industries": [
          "教育",
          "校园",
          "学校",
          "高校",
          "智慧教育"
        ],
        "scenarios": [
          "校园治理",
          "教学分析",
          "学生画像",
          "招生就业",
          "智慧校园",
          "校园安全"
        ]
      },
      "preferredThemes": [
        "galaxy-azure",
        "fresh-verdant",
        "frost-cyan"
      ],
      "defaultTheme": "galaxy-azure",
      "reason": "教育校园类场景默认使用蓝青科技主题，可按清爽要求切换清绿或青色主题。"
    }
  ],
  "selectionExamples": [
    {
      "input": "生成一个医疗业务收入大屏",
      "expectedTheme": "fresh-verdant",
      "reason": "命中 medical-healthcare 规则，且未指定其他视觉调性。"
    },
    {
      "input": "生成一个智慧医院运营驾驶舱，风格清爽、青色",
      "expectedTheme": "frost-cyan",
      "reason": "命中医疗场景，同时用户指定青色调，优先选择 frost-cyan。"
    },
    {
      "input": "生成一个医疗大屏，但要深蓝科技风",
      "expectedTheme": "deep-tech-blue",
      "reason": "用户明确视觉调性优先于行业默认主题。"
    },
    {
      "input": "生成一个工业设备监控大屏",
      "expectedTheme": "deep-tech-blue",
      "reason": "命中 industry-manufacturing 规则。"
    }
  ],
  "userInputNote": "用户输入按中文词汇解析；英文 id、file、nameEn、CSS 文件名属于内部标识或兼容信息，不作为用户输入要求。"
