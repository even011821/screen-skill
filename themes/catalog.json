{
  "id": "screen-skill-v2-theme-catalog",
  "label": "数据大屏 V2 主题目录",
  "defaultTheme": "galaxy-azure",
  "selectionPolicy": {
    "mode": "theme-token-fit",
    "rule": "主题选择优先级：用户明确指定主题中文名称或中文别名优先，其次按用户要求的视觉调性或配色，再按行业/场景主题推荐，最后使用 defaultTheme。业务类别不得直接选择 TopNav、Shell、widget 或 background 的具体 kit 样式。",
    "priority": [
      "用户明确指定主题中文名称或中文别名",
      "用户指定的视觉调性或配色",
      "命中 scenarioThemeRules 的行业或场景线索",
      "defaultTheme"
    ],
    "constraints": [
      "用户输入默认按中文理解，不依赖英文别名、英文场景词或英文调性词。",
      "行业和场景只能作为主题推荐依据。",
      "业务类别不得直接决定 TopNav、Shell、widget 或 background 的具体 kit 样式。",
      "主题确定后，kit 样式仍必须根据 theme、resolution、status、size、adaptation、dataShape 等 catalog 字段查表选择。",
      "当行业/场景推荐与用户明确指定的视觉调性或配色冲突时，以用户明确视觉要求为准。"
    ],
    "runtimeInputs": [
      "主题ID（内部标识）",
      "中文主题名",
      "中文别名",
      "主色",
      "辅助色",
      "中文调性标签",
      "推荐场景",
      "CSS token 文件",
      "行业",
      "场景",
      "场景主题规则"
    ],
    "userInputLanguage": "zh-CN",
    "matchFieldsFromUserInput": [
      "nameZh",
      "aliases",
      "toneTags",
      "preferredScenes",
      "scenarioThemeRules.match.industries",
      "scenarioThemeRules.match.scenarios"
    ]
  },
